APP_NAME="Sentinel PLD"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sentinelpld.mx

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Mexico_City

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sentinelpld
DB_USERNAME=sentinel_user
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=sentinelpld.mx
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notificaciones@sentinelpld.mx"
MAIL_FROM_NAME="Sentinel PLD"

# Cifrado PLD/EBR (generar llaves unicas e independientes para este servidor)
# php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
PLD_ENCRYPTION_KEY=
PLD_BINDEX_KEY=

# Conector de Verificacion Opcional (ej. NuFi / AvalID)
NUFI_API_URL=https://nufi.azure-api.net
NUFI_API_KEY=
NUFI_API_KEY_GENERAL=
NUFI_API_KEY_ENRICHMENT=
NUFI_API_KEY_JUDICIAL=
NUFI_MOCK=false
NUFI_WEBHOOK_URL=https://sentinelpld.mx/api/nufi/webhook
